{
    "distro_name": "PersisOS",
    "version": "2.0",
    "arch": "amd64",
    "debian_distro": "trixie",
    "debootstrap_variant": null,
    "apt_mirror": "http://deb.debian.org/debian",
    "hostname": "persisos",
    "locale": "en_US.UTF-8",
    "timezone": "UTC",
    "root_password": null,
    "live_username": "user",
    "live_user_password": "user",
    "packages": [
        "kde-plasma-desktop",
        "plasma-widgets-addons",
        "polkit-kde-agent-1",
        "plasma-pa",
        "plasma-nm",
        "gwenview",
        "kate",
        "kcalc",
        "ark",
        "okular",
        "curl",
        "htop",
        "network-manager",
        "xorg",
        "calamares",
        "apparmor",
        "nftables"
    ],
    "exclude_packages": [
        "plasma-discover"
    ],
    "pre_chroot_scripts": [
        "#!/bin/bash\nset -e\nmkdir -p \"$ROOTFS/usr/share/backgrounds/persisos\"\ncp -r ./assets/backgrounds \"$ROOTFS/usr/share/backgrounds/persisos\"\n"
    ],
    "post_install_scripts": [
        "#!/bin/bash\nset -e\nsystemctl enable NetworkManager || true\n"
    ],
    "boot_append": "quiet splash",
    "squashfs_compression": "xz",
    "iso_filename": null
}