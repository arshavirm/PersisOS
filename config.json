{
    "distro": {
        "name": "PersisOS",
        "version": "2.0",
        "hostname": "PersisOS"
    },
    "debian": {
        "dist": "stable",
        "arch": "amd64",
        "mirror": "http://deb.debian.org/debian",
        "components": [
            "main",
            "contrib",
            "non-free",
            "non-free-firmware"
        ],
        "extra_apt_sources": []
    },
    "paths": {
        "assets_dir": "assets",
        "rootfs_dir": "rootfs",
        "live_dir": "live",
        "iso_work_dir": "iso",
        "output_dir": "output"
    },
    "accounts": {
        "root_password": "root",
        "users": [
            {
                "username": "user",
                "password": "user",
                "shell": "/bin/bash",
                "groups": [
                    "sudo",
                    "netdev"
                ],
                "create_home": true
            }
        ]
    },
    "boot": {
        "plymouth_theme": "persisos"
    },
    "grub": {
        "defaults": {
            "GRUB_BACKGROUND": "\"/usr/share/backgrounds/persisos/background_2.png\"",
            "GRUB_TERMINAL_OUTPUT": "\"gfxterm\"",
            "GRUB_GFXMODE": "\"auto\""
        }
    },
    "squashfs": {
        "comp": "xz",
        "block_size": "1M",
        "exclude_wildcards": [
            "boot/memtest86*"
        ]
    },
    "chroot_finalize": {
        "machine_id_setup": true,
        "autoremove": true,
        "apt_clean": true,
        "update_initramfs": true
    },
    "packages": {
        "groups": {
            "firmware": [
                "firmware-linux",
                "firmware-linux-free",
                "firmware-linux-nonfree",
                "firmware-misc-nonfree",
                "firmware-realtek",
                "firmware-atheros",
                "firmware-iwlwifi",
                "firmware-brcm80211",
                "firmware-mediatek",
                "linux-image-amd64",
                "live-boot",
                "live-config",
                "live-config-systemd",
                "grub2",
                "memtest86+",
                "shim-signed",
                "systemd",
                "systemd-sysv"
            ],
            "network": [
                "network-manager",
                "network-manager-gnome",
                "wpasupplicant",
                "iw",
                "rfkill",
                "wireless-regdb"
            ],
            "desktop": [
                "xorg",
                "lightdm",
                "lightdm-gtk-greeter",
                "kde-plasma-desktop"
            ],
            "apps": [
                "pipewire",
                "pipewire-pulse",
                "wireplumber",
                "alsa-utils",
                "pavucontrol",
                "wget",
                "p7zip-full",
                "zip",
                "unzip",
                "usbutils",
                "pciutils",
                "librsvg2-common",
                "dosfstools",
                "sudo"
            ],
            "installer": [
                "calamares",
                "calamares-settings-debian"
            ]
        },
        "extra": []
    },
    "services": [
        "lightdm",
        "NetworkManager",
        "avahi-daemon"
    ],
    "_comment_files": "Each entry copies src (relative to the project dir) to dest (relative to the rootfs root). stage='before_chroot' runs before the chroot script (packages, users, etc.) executes; 'after_chroot' runs after, so package-owned conffiles (calamares, grub) aren't clobbered by dpkg. type is 'dir' or 'file'; inferred from the source if omitted. mode is an optional octal permission string.",
    "files": [
        {
            "src": "assets/backgrounds",
            "dest": "usr/share/backgrounds/persisos",
            "type": "dir",
            "stage": "before_chroot"
        },
        {
            "src": "persisos.svg",
            "dest": "usr/share/pixmaps/persisos/persisos.svg",
            "stage": "before_chroot",
            "mode": "644"
        },
        {
            "src": "persisos.svg",
            "dest": "usr/share/pixmaps/persisos.svg",
            "stage": "before_chroot",
            "mode": "644"
        },
        {
            "src": "assets/os-release",
            "dest": "etc/os-release",
            "stage": "before_chroot",
            "mode": "644"
        },
        {
            "src": "assets/os-release",
            "dest": "usr/lib/os-release",
            "stage": "before_chroot",
            "mode": "644"
        },
        {
            "src": "assets/plymouth/persisos",
            "dest": "usr/share/plymouth/themes/persisos",
            "type": "dir",
            "stage": "before_chroot"
        },
        {
            "src": "assets/.face",
            "dest": "etc/skel/.face",
            "stage": "before_chroot",
            "mode": "644"
        },
        {
            "src": "assets/.face",
            "dest": "root/.face",
            "stage": "before_chroot",
            "mode": "644"
        },
        {
            "src": "assets/calamares/persisos",
            "dest": "etc/calamares/branding/persisos",
            "type": "dir",
            "stage": "after_chroot"
        },
        {
            "src": "assets/calamares/settings.conf",
            "dest": "etc/calamares/settings.conf",
            "stage": "after_chroot",
            "mode": "644"
        },
        {
            "src": "assets/calamares/packages.conf",
            "dest": "etc/calamares/modules/packages.conf",
            "stage": "after_chroot",
            "mode": "644"
        },
        {
            "src": "assets/calamares/packagechooser.conf",
            "dest": "etc/calamares/modules/packagechooser.conf",
            "stage": "after_chroot",
            "mode": "644"
        },
        {
            "src": "assets/calamares-install-persisos.desktop",
            "dest": "usr/share/applications/calamares-install-persisos.desktop",
            "stage": "after_chroot",
            "mode": "644"
        },
        {
            "src": "assets/grub.cfg",
            "dest": "boot/grub/grub.cfg",
            "stage": "after_chroot",
            "mode": "644"
        },
        {
            "src": "assets/lightdm-gtk-greeter.conf",
            "dest": "etc/lightdm/lightdm-gtk-greeter.conf",
            "stage": "after_chroot",
            "mode": "644"
        },
        {
            "src": "assets/persisos-first-login",
            "dest": "usr/local/bin/persisos-first-login",
            "stage": "after_chroot",
            "mode": "755"
        }
    ],
    "_comment_cleanup": "Globs (relative to rootfs root) removed right before the after_chroot file copy runs.",
    "cleanup_globs": [
        "usr/share/applications/calamares*.desktop",
        "etc/xdg/autostart/calamares*.desktop"
    ],
    "_comment_hooks": "Arbitrary shell scripts run at named extension points.",
    "hooks": [
        {
            "name": "install-apadana",
            "point": "chroot:after_packages",
            "enabled": true,
            "continue_on_error": false,
            "script": "wget -O /tmp/apadana.deb https://github.com/arshavirm/apadana/releases/download/1.2/apadana_1.2_amd64.deb\napt-get install -y /tmp/apadana.deb --no-install-recommends\nrm -f /tmp/apadana.deb"
        }
    ]
}