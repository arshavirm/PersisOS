// PersisOS Plymouth theme

Window.SetBackgroundTopColor(0.05, 0.05, 0.05);
Window.SetBackgroundBottomColor(0.05, 0.05, 0.05);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();
center_x = screen_width  / 2;
center_y = screen_height / 2;

logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(center_x - logo.image.GetWidth()  / 2);
logo.sprite.SetY(center_y - logo.image.GetHeight() / 2);
logo.sprite.SetZ(10000);

spinner.image  = Image("spinner.png");
spinner.sprite = Sprite();
spinner.sprite.SetZ(9999);

spinner.speed = 220;

fun spinner_refresh_callback() {
    angle_deg = (Plymouth.GetTime() * spinner.speed) % 360;
    angle_rad = angle_deg * 3.14159265 / 180;

    rotated = spinner.image.Rotate(angle_rad);

    spinner.sprite.SetImage(rotated);
    spinner.sprite.SetX(center_x - rotated.GetWidth()  / 2);
    spinner.sprite.SetY(center_y - rotated.GetHeight() / 2);
}

Plymouth.SetRefreshFunction(spinner_refresh_callback);

message.sprite = Sprite();
message.sprite.SetZ(10001);

fun message_callback(text) {
    message.image = Image.Text(text, 1, 1, 1, 1, "Sans 12");
    message.sprite.SetImage(message.image);
    message.sprite.SetX(center_x - message.image.GetWidth() / 2);
    message.sprite.SetY(center_y + 140);
}

Plymouth.SetMessageFunction(message_callback);

password.box.sprite = Sprite();
password.box.sprite.SetZ(10001);
password.state = 0;

fun display_password_callback(prompt, bullets) {
    local.text = "";
    i = 0;
    while (i < bullets) {
        local.text += "*";
        i++;
    }
    if (prompt) {
        local.text = prompt + ": " + local.text;
    }
    password.box.image = Image.Text(local.text, 1, 1, 1, 1, "Sans 14");
    password.box.sprite.SetImage(password.box.image);
    password.box.sprite.SetX(center_x - password.box.image.GetWidth() / 2);
    password.box.sprite.SetY(center_y + 170);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    password.box.sprite.SetImage(Image());
    message.sprite.SetImage(Image());
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
